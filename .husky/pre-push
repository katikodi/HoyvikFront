#!/usr/bin/env sh
set -e

# Setup directories
REPO_ROOT="$(git rev-parse --show-toplevel)"
FRONTEND_DIR="$REPO_ROOT/frontend"
NODE_MODULES="$FRONTEND_DIR/node_modules"

if [ ! -d "$NODE_MODULES" ]; then
    echo "✗ Error: frontend/node_modules is missing. Run 'npm --prefix frontend install' first."
    exit 1
fi

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    TEMP_DIR="$(mktemp -d)"

    cleanup() {
        git -C "$REPO_ROOT" worktree remove --force "$TEMP_DIR" >/dev/null 2>&1 || true
        rm -rf "$TEMP_DIR"
    }
    trap cleanup EXIT INT TERM

    echo "==> Verifying $LOCAL_REF ($LOCAL_SHA)"
    
    git -C "$REPO_ROOT" worktree add --detach "$TEMP_DIR" "$LOCAL_SHA" >/dev/null

    if [ -n "$COMSPEC" ] || [ -n "$MSYSTEM" ]; then
        cmd.exe /c "mklink /J \"$TEMP_DIR\\frontend\\node_modules\" \"$NODE_MODULES\"" >/dev/null 2>&1
    else
        ln -s "$NODE_MODULES" "$TEMP_DIR/frontend/node_modules"
    fi

    echo "→ Running Linter..."
    (cd "$TEMP_DIR/frontend" && npm run lint)

    echo "→ Running Build..."
    (cd "$TEMP_DIR/frontend" && npm run build)

    echo "✓ Push checks passed for $LOCAL_SHA"

    cleanup
    trap - EXIT INT TERM
done