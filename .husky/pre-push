#!/usr/bin/env sh

set -e

# COLORS
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RESET='\033[0m'

print_step() {
    printf "\n${BLUE}==> %s${RESET}\n" "$1"
}

print_success() {
    printf "${GREEN}✓ %s${RESET}\n" "$1"
}

print_error() {
    printf "${RED}✗ %s${RESET}\n" "$1"
}

echo ""
printf "${BLUE}========================================${RESET}\n"
printf "${BLUE}        RUNNING PRE-PUSH CHECKS        ${RESET}\n"
printf "${BLUE}========================================${RESET}\n"

REPO_ROOT="$(git rev-parse --show-toplevel)"
NODE_MODULES="$REPO_ROOT/frontend/node_modules"

if [ ! -d "$NODE_MODULES" ]; then
    print_error "frontend/node_modules does not exist."
    printf "${YELLOW}Run: npm --prefix frontend install${RESET}\n"
    exit 1
fi

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    TEMP_DIR="$(mktemp -d)"

    cleanup() {
        git -C "$REPO_ROOT" worktree remove --force "$TEMP_DIR" >/dev/null 2>&1 || true
        rm -rf "$TEMP_DIR"
    }

    trap cleanup EXIT INT TERM

    print_step "Checking $LOCAL_REF @ ${LOCAL_SHA}"

    printf "${BLUE}→ Creating temporary worktree...${RESET}\n"

    git -C "$REPO_ROOT" worktree add --detach "$TEMP_DIR" "$LOCAL_SHA" >/dev/null

    print_success "Temporary worktree created"

    printf "${BLUE}→ Linking existing node_modules...${RESET}\n"

    cmd.exe /c "mklink /J \"$TEMP_DIR\\frontend\\node_modules\" \"$NODE_MODULES\"" > /dev/null 2>&1

    print_success "node_modules linked"

    print_step "Running Oxlint"

    if ! npm --prefix "$TEMP_DIR/frontend" run lint; then
        print_error "Oxlint failed."
        printf "${RED}Push rejected.${RESET}\n"
        exit 1
    fi

    print_success "Oxlint passed"

    print_step "Building frontend"

    if ! npm --prefix "$TEMP_DIR/frontend" run build; then
        print_error "Vite build failed."
        printf "${RED}Push rejected.${RESET}\n"
        exit 1
    fi

    print_success "Vite build passed"

    cleanup
    trap - EXIT INT TERM
done

echo ""
printf "${GREEN}========================================${RESET}\n"
printf "${GREEN}        PRE-PUSH CHECKS PASSED         ${RESET}\n"
printf "${GREEN}========================================${RESET}\n"
echo ""