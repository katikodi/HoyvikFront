{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Git Rename File",
            "type": "shell",
            "command": "git mv '${file}' '$(dirname '${file}')/${input:newFileName}'",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ],
    "inputs": [
        {
            "id": "newFileName",
            "type": "promptString",
            "description": "Enter the new filename (with extension):",
            "default": "NewName.ts"
        }
    ]
}
