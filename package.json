{
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6"
    },
    "scripts": {
        "prepare": "husky",
        "build": "npm --prefix ./frontend run build",
        "publish-vps": "npm --prefix ./frontend run build && aspire publish && aspire deploy"
    },
    "lint-staged": {
        "frontend/**/*.{ts,tsx,js,jsx,css,html,json,md}": "prettier --write --config .prettierrc_prod.json",
        "backend/Hoyvik.API/**/*.cs": "dotnet format backend/Hoyvik.API/Hoyvik.API.csproj --no-restore --include --exclude backend/Hoyvik.API/Migrations",
        "backend/Hoyvik.MigrationService/**/*.cs": "dotnet format backend/Hoyvik.MigrationService/Hoyvik.MigrationService.csproj --no-restore --include"
    }
}
